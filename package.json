{
  "name": "baytikk-whatsapp-agent",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp customer-support agent for Baytikk (baytikk.com), powered by Claude and the Shopify Admin API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "chat": "tsx scripts/chat-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
