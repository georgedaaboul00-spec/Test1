# --- Claude (https://console.anthropic.com -> API keys) ---------------------
ANTHROPIC_API_KEY=sk-ant-...
# Default is claude-opus-5-5 (best quality). claude-haiku-5-5 is ~40x cheaper - test it first.
AGENT_MODEL=claude-opus-5-5
# low | medium | high. "low" is fast and plenty for shop chat.
AGENT_EFFORT=low

# --- Shopify ----------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=baytikklb.myshopify.com
STOREFRONT_URL=https://baytikk.com
# Option A: a static Admin API access token (shpat_...)
SHOPIFY_ADMIN_TOKEN=
# Option B: a Dev Dashboard app's client ID + secret (token is fetched automatically)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Needed scopes: read_products, read_orders

# --- WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp) ----
WHATSAPP_ACCESS_TOKEN=          # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=       # the business number's Phone number ID
WHATSAPP_VERIFY_TOKEN=          # any random string; paste the same in the webhook settings
WHATSAPP_APP_SECRET=            # App settings -> Basic -> App secret (verifies webhook calls)

# --- Hand-off -----------------------------------------------------------------
# Your personal WhatsApp number, digits only with country code (gets hand-off alerts, can send "bot on/off")
OWNER_WHATSAPP=961XXXXXXXX
HANDOFF_PAUSE_HOURS=12
CONVERSATION_TTL_HOURS=24

PORT=3000
